    function sanitizeText(str, maxLen = 300) {
      if (typeof str !== 'string') return '';
      return str
        .replace(/[\u0000-\u001F\u007F]/g, ' ')
        .replace(/javascript:|data:/gi, '')
        .trim()
        .slice(0, maxLen);
    }

    function escapeRegExp(string) {
      return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }

    function safeJsonParse(raw, fallback) {
      try {
        if (!raw) return fallback;
        const parsed = JSON.parse(raw, (key, value) => {
          if (key === '__proto__' || key === 'constructor' || key === 'prototype') return undefined;
          return value;
        });
        return parsed ?? fallback;
      } catch {
        return fallback;
      }
    }

    async function hashPassword(password, saltStr) {
      const enc = new TextEncoder();
      const keyMaterial = await crypto.subtle.importKey(
        'raw',
        enc.encode(password),
        { name: 'PBKDF2' },
        false,
        ['deriveBits']
      );
      const bits = await crypto.subtle.deriveBits(
        { name: 'PBKDF2', salt: enc.encode(saltStr), iterations: 100000, hash: 'SHA-256' },
        keyMaterial,
        256
      );
      return Array.from(new Uint8Array(bits)).map(b => b.toString(16).padStart(2, '0')).join('');
    }

    async function extractRealPdfData(file) {
      if (!file || file.size === 0 || file.size > MAX_FILE_SIZE_BYTES) {
        throw new Error('Invalid file size');
      }
      const buffer = await file.arrayBuffer();
      const header = String.fromCharCode(...new Uint8Array(buffer.slice(0, 5)));
      if (header !== '%PDF-') {
        throw new Error('Invalid PDF signature');
      }
      if (!window.pdfjsLib) {
        return {
          numPages: 1,
          pages: [{ page: 1, text: file.name }]
        };
      }
      const pdf = await window.pdfjsLib.getDocument({ data: buffer, isEvalSupported: false }).promise;
      const numPages = Math.min(pdf.numPages, MAX_PAGES_PER_PDF);
      const pages = [];
      for (let i = 1; i <= numPages; i++) {
        const page = await pdf.getPage(i);
        const content = await page.getTextContent();
        const text = content.items.map(item => item.str).join(' ').replace(/\s+/g, ' ').trim();
        pages.push({ page: i, text });
      }
      return { numPages, pages };
    }

    // Motore locale di generazione domande reali, impegnative e ben formattate
    function buildQuestionsFromSelectedDocs(docs, requestedCount, lang) {
      const STOPWORDS = new Set([
        'questo', 'questa', 'questi', 'queste', 'quello', 'quella', 'quelli', 'quelle',
        'essere', 'avere', 'fare', 'dire', 'andare', 'venire', 'potere', 'volere', 'dovere',
        'anche', 'come', 'dove', 'quando', 'perche', 'quindi', 'inoltre', 'tuttavia', 'mentre',
        'attraverso', 'mediante', 'secondo', 'durante', 'senza', 'verso', 'oltre', 'circa',
        'prima', 'dopo', 'sempre', 'spesso', 'molto', 'poco', 'tanto', 'ogni', 'altro', 'altra',
        'altri', 'altre', 'stesso', 'stessa', 'proprio', 'propria', 'quale', 'quali', 'pagina',
        'capitolo', 'paragrafo', 'figura', 'tabella', 'esempio', 'esercizi', 'universita',
        'which', 'their', 'there', 'these', 'those', 'where', 'when', 'while', 'through',
        'between', 'during', 'without', 'within', 'about', 'after', 'before', 'other', 'another',
        'because', 'however', 'therefore', 'moreover', 'although', 'whether', 'being', 'having'
      ]);

      const CAUSE_MARKERS = /\b(quindi|pertanto|di conseguenza|provoca|determina|causa|comporta|implica|genera|favorisce|inibisce|riduce|aumenta|therefore|thus|consequently|causes|leads to|results in|increases|decreases|inhibits|promotes|por lo tanto|provoca|daher|führt zu|donc|entraîne)\b/i;
      const DEF_MARKERS = /\b(si definisce|è definito|rappresenta|consiste in|indica|significa|costituisce|è caratterizzato|is defined as|refers to|represents|consists of|means|se define|ist definiert|désigne|consiste à)\b/i;

      const isMeaningfulSentence = (s) => {
        if (!s || s.length < 65 || s.length > 310) return false;
        if (s.startsWith('(Pagina')) return false;
        if (/^(fig\.|tab\.|cap\.|pag\.|es\.|cfr\.|http|www\.|\d+[\.\)])/i.test(s)) return false;
        const letters = (s.match(/[A-Za-zÀ-ÿ]/g) || []).length;
        const digits = (s.match(/\d/g) || []).length;
        if (letters < s.length * 0.65 || digits > s.length * 0.18) return false;
        const words = s.split(/\s+/);
        if (words.length < 10 || words.length > 52) return false;
        return true;
      };

      const extractKeyTerms = (sentence) => {
        const rawWords = sentence.match(/\b[A-Za-zÀ-ÿ]{6,}\b/g) || [];
        return rawWords.filter(w => !STOPWORDS.has(w.toLowerCase()));
      };

      const pool = [];
      const termStats = new Map(); // wordLower -> { display, len, isCapitalized }

      docs.forEach(doc => {
        (doc.pages || []).forEach(p => {
          const cleanedText = (p.text || '')
            .replace(/\s+/g, ' ')
            .replace(/([a-zà-ÿ])\s+-\s+([a-zà-ÿ])/gi, '$1$2');

          const sentences = cleanedText
            .split(/(?<=[.!?])\s+(?=[A-ZÀ-Ÿ0-9«"(])/)
            .map(s => s.trim())
            .filter(isMeaningfulSentence);

          sentences.forEach((sentence, idx) => {
            const terms = extractKeyTerms(sentence);
            terms.forEach((term, tIdx) => {
              const key = term.toLowerCase();
              if (!termStats.has(key)) {
                termStats.set(key, {
                  display: term,
                  len: term.length,
                  isMidCap: tIdx > 0 && /^[A-ZÀ-Ÿ]/.test(term)
                });
              }
            });

            if (terms.length >= 3) {
              pool.push({
                docId: doc.id,
                docName: doc.name,
                page: p.page,
                sentence,
                nextSentence: sentences[idx + 1] || '',
                terms,
                hasCause: CAUSE_MARKERS.test(sentence),
                hasDef: DEF_MARKERS.test(sentence)
              });
            }
          });
        });
      });

      const allTermEntries = Array.from(termStats.values());
      const count = Math.min(30, Math.max(1, Number(requestedCount) || 5));
      const questions = [];

      // Fallback se il PDF è solo immagini/scansione senza testo selezionabile
      if (pool.length === 0) {
        for (let i = 0; i < count; i++) {
          const doc = docs[i % docs.length];
          const pageObj = doc.pages[i % doc.pages.length] || { page: 1, text: doc.name };
          const qText = lang === 'en'
            ? `Source verification on "${doc.name}" (Page ${pageObj.page}): confirm whether this page contains extractable text or requires visual review.`
            : `Verifica fonte su "${doc.name}" (Pagina ${pageObj.page}): conferma se la pagina contiene testo estraibile o richiede controllo visivo.`;
          const yesLabel = lang === 'en' ? 'Scanned / graphic page — inspect original PDF' : 'Pagina grafica/scansione — verifica sul PDF originale';
          const noLabel = lang === 'en' ? 'Plain text table of contents only' : 'Solo indice testuale senza contenuto';
          questions.push({
            id: `q_${i}_${Date.now()}`,
            type: 'true_false',
            question: qText,
            options: [yesLabel, noLabel],
            correctAnswer: yesLabel,
            docId: doc.id,
            docName: doc.name,
            sourcePage: pageObj.page,
            sourceQuote: pageObj.text.slice(0, 240)
          });
        }
        return questions;
      }

      // Prioritizza frasi dense (definizioni, nessi causa-effetto, concetti tecnici)
      const prioritizedPool = [...pool].sort((a, b) => {
        const scoreA = (a.hasCause ? 3 : 0) + (a.hasDef ? 3 : 0) + Math.min(4, a.terms.length * 0.5);
        const scoreB = (b.hasCause ? 3 : 0) + (b.hasDef ? 3 : 0) + Math.min(4, b.terms.length * 0.5);
        return (scoreB - scoreA) + (Math.random() - 0.5) * 2.2;
      });

      const pickSmartDistractors = (targetWord, excludeSet, needed = 3) => {
        const targetLower = targetWord.toLowerCase();
        const targetLen = targetWord.length;
        const targetIsCap = /^[A-ZÀ-Ÿ]/.test(targetWord);

        const scored = allTermEntries
          .filter(entry => {
            const low = entry.display.toLowerCase();
            if (low === targetLower || excludeSet.has(low)) return false;
            if (low.includes(targetLower) || targetLower.includes(low)) return false;
            return true;
          })
          .map(entry => {
            let score = 0;
            const lenDiff = Math.abs(entry.len - targetLen);
            if (lenDiff <= 2) score += 4;
            else if (lenDiff <= 4) score += 2;
            if (entry.isMidCap === targetIsCap) score += 2;
            if (entry.display.slice(-3).toLowerCase() === targetLower.slice(-3)) score += 3; // Stessa desinenza grammaticale
            score += Math.random() * 2.5;
            return { word: entry.display, score };
          })
          .sort((a, b) => b.score - a.score);

        const chosen = [];
        for (const item of scored) {
          if (chosen.length >= needed) break;
          if (!chosen.some(c => c.toLowerCase() === item.word.toLowerCase())) {
            chosen.push(item.word);
          }
        }

        const academicFallbacks = lang === 'en'
          ? ['Equilibrium', 'Synthesis', 'Regulation', 'Mechanism', 'Variation', 'Threshold']
          : ['Equilibrio', 'Regolazione', 'Meccanismo', 'Variazione', 'Inibizione', 'Struttura'];

        let idx = 0;
        while (chosen.length < needed && idx < academicFallbacks.length) {
          const fb = academicFallbacks[idx++];
          if (fb.toLowerCase() !== targetLower && !chosen.some(c => c.toLowerCase() === fb.toLowerCase())) {
            chosen.push(fb);
          }
        }
        return chosen;
      };

      const labels = {
        it: {
          conceptTag: 'Analisi concettuale',
          causeTag: 'Relazione causa-effetto',
          tfTag: 'Vero o Falso ragionato',
          clozePrompt: (doc, page) => `[${doc} • Pag. ${page}] Quale termine tecnico completa correttamente la seguente affermazione?`,
          causePrompt: (doc, page) => `[${doc} • Pag. ${page}] Secondo il testo, quale elemento completa il nesso logico espresso nel passaggio?`,
          tfPrompt: (doc, page) => `[${doc} • Pag. ${page}] Valuta l'accuratezza della seguente affermazione rispetto al testo della dispensa:`,
          tfTrue: 'Vero — Rispecchia fedelmente quanto riportato nel testo',
          tfFalse: 'Falso — Altera un concetto chiave rispetto al testo originale'
        },
        en: {
          conceptTag: 'Conceptual analysis',
          causeTag: 'Cause & effect',
          tfTag: 'Critical True / False',
          clozePrompt: (doc, page) => `[${doc} • p. ${page}] Which technical term accurately completes the following statement?`,
          causePrompt: (doc, page) => `[${doc} • p. ${page}] Based on the text, which element completes the logical relationship below?`,
          tfPrompt: (doc, page) => `[${doc} • p. ${page}] Evaluate whether the following statement accurately reflects the lecture notes:`,
          tfTrue: 'True — Accurately matches the source text',
          tfFalse: 'False — Distorts a key concept from the source text'
        },
        es: {
          conceptTag: 'Análisis conceptual',
          causeTag: 'Causa y efecto',
          tfTag: 'Verdadero o Falso razonado',
          clozePrompt: (doc, page) => `[${doc} • Pág. ${page}] ¿Qué término técnico completa correctamente la siguiente afirmación?`,
          causePrompt: (doc, page) => `[${doc} • Pág. ${page}] Según el texto, ¿qué elemento completa la relación lógica descrita?`,
          tfPrompt: (doc, page) => `[${doc} • Pág. ${page}] Evalúa la exactitud de la siguiente afirmación respecto al texto:`,
          tfTrue: 'Verdadero — Refleja fielmente el contenido del texto',
          tfFalse: 'Falso — Altera un concepto clave del texto original'
        },
        de: {
          conceptTag: 'Konzeptanalyse',
          causeTag: 'Ursache & Wirkung',
          tfTag: 'Kritisches Richtig / Falsch',
          clozePrompt: (doc, page) => `[${doc} • S. ${page}] Welcher Fachbegriff vervollständigt die folgende Aussage korrekt?`,
          causePrompt: (doc, page) => `[${doc} • S. ${page}] Welches Element vervollständigt laut Text den logischen Zusammenhang?`,
          tfPrompt: (doc, page) => `[${doc} • S. ${page}] Prüfe, ob die folgende Aussage den Inhalt des Skripts korrekt wiedergibt:`,
          tfTrue: 'Richtig — Entspricht exakt dem Originaltext',
          tfFalse: 'Falsch — Verändert einen zentralen Begriff des Textes'
        },
        fr: {
          conceptTag: 'Analyse conceptuelle',
          causeTag: 'Cause à effet',
          tfTag: 'Vrai ou Faux raisonné',
          clozePrompt: (doc, page) => `[${doc} • p. ${page}] Quel terme technique complète correctement l'affirmation suivante ?`,
          causePrompt: (doc, page) => `[${doc} • p. ${page}] D'après le texte, quel élément complète le lien logique ci-dessous ?`,
          tfPrompt: (doc, page) => `[${doc} • p. ${page}] Évalue l'exactitude de l'affirmation suivante par rapport au cours :`,
          tfTrue: 'Vrai — Correspond fidèlement au texte source',
          tfFalse: 'Faux — Modifie une notion clé du texte original'
        }
      }[lang] || {
        conceptTag: 'Analisi concettuale',
        causeTag: 'Relazione causa-effetto',
        tfTag: 'Vero o Falso ragionato',
        clozePrompt: (doc, page) => `[${doc} • Pag. ${page}] Quale termine tecnico completa correttamente la seguente affermazione?`,
        causePrompt: (doc, page) => `[${doc} • Pag. ${page}] Secondo il testo, quale elemento completa il nesso logico espresso nel passaggio?`,
        tfPrompt: (doc, page) => `[${doc} • Pag. ${page}] Valuta l'accuratezza della seguente affermazione rispetto al testo della dispensa:`,
        tfTrue: 'Vero — Rispecchia fedelmente quanto riportato nel testo',
        tfFalse: 'Falso — Altera un concetto chiave rispetto al testo originale'
      };

      for (let i = 0; i < count; i++) {
        const item = prioritizedPool[i % prioritizedPool.length];
        // Sceglie i termini più lunghi e specifici della frase (escludendo parole banali)
        const rankedTerms = [...item.terms].sort((a, b) => b.length - a.length);
        const targetWord = rankedTerms[Math.floor(i / prioritizedPool.length) % Math.min(3, rankedTerms.length)];
        const safeRegex = new RegExp(`\\b${escapeRegExp(targetWord)}\\b`);

        // Alterna 3 formati di domanda: 1) Causa-effetto / Completamento mirato, 2) Vero/Falso con alterazione sottile, 3) Analisi concettuale
        const variant = i % 4;

        if (variant === 2 && allTermEntries.length >= 4) {
          // Vero / Falso ragionato: nel 50% dei casi sostituisce un termine chiave con un distrattore plausibile
          const makeFalse = Math.random() < 0.5;
          let statement = item.sentence;
          if (makeFalse) {
            const [sub] = pickSmartDistractors(targetWord, new Set(item.terms.map(t => t.toLowerCase())), 1);
            if (sub) {
              statement = item.sentence.replace(safeRegex, sub);
            }
          }
          const isStatementActuallyTrue = statement === item.sentence;
          questions.push({
            id: `q_${i}_${Date.now()}_${Math.random().toString(36).slice(2, 6)}`,
            type: 'true_false',
            badge: labels.tfTag,
            question: labels.tfPrompt(item.docName, item.page),
            excerpt: `«${statement}»`,
            options: [labels.tfTrue, labels.tfFalse],
            correctAnswer: isStatementActuallyTrue ? labels.tfTrue : labels.tfFalse,
            docId: item.docId,
            docName: item.docName,
            sourcePage: item.page,
            sourceQuote: item.sentence
          });
        } else {
          // Risposta multipla ad alta precisione con distrattori della stessa categoria morfologica
          const maskedSentence = item.sentence.replace(safeRegex, ' [ ______ ] ');
          const excludeSameSentence = new Set(item.terms.map(t => t.toLowerCase()));
          const distractors = pickSmartDistractors(targetWord, excludeSameSentence, 3);
          const options = [targetWord, ...distractors].sort(() => Math.random() - 0.5);

          const isCauseQuestion = item.hasCause || variant === 1;
          questions.push({
            id: `q_${i}_${Date.now()}_${Math.random().toString(36).slice(2, 6)}`,
            type: 'multiple_choice',
            badge: isCauseQuestion ? labels.causeTag : labels.conceptTag,
            question: isCauseQuestion
              ? labels.causePrompt(item.docName, item.page)
              : labels.clozePrompt(item.docName, item.page),
            excerpt: `«${maskedSentence}»`,
            options,
            correctAnswer: targetWord,
            docId: item.docId,
            docName: item.docName,
            sourcePage: item.page,
            sourceQuote: item.sentence
          });
        }
      }

      return questions;
    }

    function App() {
      // Stato UI & Preferenze
      const [lang, setLang] = useState(() => localStorage.getItem('nailedit_lang') || 'it');
      const [darkMode, setDarkMode] = useState(() => localStorage.getItem('nailedit_dark') === 'true');
      const [activeTab, setActiveTab] = useState('quiz'); // 'quiz' | 'files' | 'account'
      const [toastMsg, setToastMsg] = useState('');
      const [nailedItStamp, setNailedItStamp] = useState(false);

      const t = TRANSLATIONS[lang] || TRANSLATIONS.it;

      useEffect(() => {
        localStorage.setItem('nailedit_lang', lang);
      }, [lang]);

      useEffect(() => {
        localStorage.setItem('nailedit_dark', String(darkMode));
        if (darkMode) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      }, [darkMode]);

      const showToast = useCallback((msg) => {
        setToastMsg(msg);
        setTimeout(() => setToastMsg(''), 3400);
      }, []);

      // Libreria PDF e Cartelle (zero preset iniziali)
      const [docs, setDocs] = useState(() => {
        const parsed = safeJsonParse(localStorage.getItem('nailedit_docs'), []);
        return Array.isArray(parsed) ? parsed.slice(0, MAX_PDFS) : [];
      });
      const [folders, setFolders] = useState(() => {
        const parsed = safeJsonParse(localStorage.getItem('nailedit_folders'), []);
        return Array.isArray(parsed) ? parsed.slice(0, 60) : [];
      });
      const [selectedDocIds, setSelectedDocIds] = useState([]);
      const [uploadTargetFolderId, setUploadTargetFolderId] = useState('');
      const [newFolderName, setNewFolderName] = useState('');
      const [newFolderColor, setNewFolderColor] = useState('amber');
      const [isParsingPdf, setIsParsingPdf] = useState(false);
      const [isFilePickerOpen, setIsFilePickerOpen] = useState(false);

      useEffect(() => {
        try {
          localStorage.setItem('nailedit_docs', JSON.stringify(docs));
        } catch {
          // Ignora eventuale quota piena del browser
        }
      }, [docs]);

      useEffect(() => {
        try {
          localStorage.setItem('nailedit_folders', JSON.stringify(folders));
        } catch {}
      }, [folders]);

      // Mappe veloci per libreria fino a 130 PDF
      const docMap = useMemo(() => {
        const m = new Map();
        docs.forEach(d => m.set(d.id, d));
        return m;
      }, [docs]);

      const selectedSet = useMemo(() => new Set(selectedDocIds), [selectedDocIds]);

      const selectedDocs = useMemo(
        () => selectedDocIds.map(id => docMap.get(id)).filter(Boolean),
        [selectedDocIds, docMap]
      );

      // Caricamento multiplo PDF
      const handleFilesUpload = async (fileList) => {
        const files = Array.from(fileList || []);
        if (!files.length) return;

        const availableSlots = MAX_PDFS - docs.length;
        if (availableSlots <= 0) {
          showToast(t.limitReached);
          return;
        }

        const batch = files.slice(0, availableSlots);
        setIsParsingPdf(true);

        const newlyAdded = [];
        for (const file of batch) {
          try {
            const extracted = await extractRealPdfData(file);
            newlyAdded.push({
              id: `doc_${Date.now()}_${Math.random().toString(36).slice(2, 7)}`,
              name: sanitizeText(file.name, 90),
              numPages: extracted.numPages,
              pages: extracted.pages,
              folderIds: uploadTargetFolderId ? [uploadTargetFolderId] : [],
              addedAt: new Date().toLocaleDateString()
            });
          } catch {
            showToast(t.invalidPdf);
          }
        }

        if (newlyAdded.length > 0) {
          setDocs(prev => [...newlyAdded, ...prev]);
          setSelectedDocIds(prev => [...new Set([...prev, ...newlyAdded.map(d => d.id)])]);
        }
        setIsParsingPdf(false);
      };

      const handleCreateFolder = (e) => {
        e.preventDefault();
        const clean = sanitizeText(newFolderName, 40);
        if (!clean) return;
        const folder = {
          id: `fld_${Date.now()}`,
          name: clean,
          color: newFolderColor
        };
        setFolders(prev => [...prev, folder]);
        setUploadTargetFolderId(folder.id);
        setNewFolderName('');
      };

      const handleDeleteFolder = (folderId) => {
        setFolders(prev => prev.filter(f => f.id !== folderId));
        setDocs(prev => prev.map(d => ({
          ...d,
          folderIds: (d.folderIds || []).filter(id => id !== folderId)
        })));
        if (uploadTargetFolderId === folderId) setUploadTargetFolderId('');
      };

      const toggleDocInFolder = (docId, folderId) => {
        setDocs(prev => prev.map(d => {
          if (d.id !== docId) return d;
          const current = new Set(d.folderIds || []);
          if (current.has(folderId)) current.delete(folderId);
          else current.add(folderId);
          return { ...d, folderIds: Array.from(current) };
        }));
      };

      const toggleDocSelection = (docId) => {
        setSelectedDocIds(prev =>
          prev.includes(docId) ? prev.filter(id => id !== docId) : [...prev, docId]
        );
      };

      const toggleFolderGroupSelection = (folderId) => {
        const folderDocIds = docs.filter(d => (d.folderIds || []).includes(folderId)).map(d => d.id);
        if (folderDocIds.length === 0) return;
        const allSelected = folderDocIds.every(id => selectedSet.has(id));
        if (allSelected) {
          const removeSet = new Set(folderDocIds);
          setSelectedDocIds(prev => prev.filter(id => !removeSet.has(id)));
        } else {
          setSelectedDocIds(prev => Array.from(new Set([...prev, ...folderDocIds])));
        }
      };

      const handleDeleteDoc = (docId) => {
        setDocs(prev => prev.filter(d => d.id !== docId));
        setSelectedDocIds(prev => prev.filter(id => id !== docId));
      };

      // Configurazione e Player Quiz / Esame / Flashcard
      const [quizMode, setQuizMode] = useState('classic'); // 'classic' | 'exam' | 'flashcards'
      const [questionCountInput, setQuestionCountInput] = useState('8');
      const [sessionPhase, setSessionPhase] = useState('setup'); // 'setup' | 'active' | 'results'
      const [questions, setQuestions] = useState([]);
      const [currentIndex, setCurrentIndex] = useState(0);
      const [selectedOption, setSelectedOption] = useState(null);
      const [answersLog, setAnswersLog] = useState([]);
      const [timeLeft, setTimeLeft] = useState(45);
      const [isCardFlipped, setIsCardFlipped] = useState(false);

      // Modale riscontro pagina originale PDF
      const [pdfModal, setPdfModal] = useState(null); // { docId, page, quote }

      // Account & Cronologia
      const [currentUser, setCurrentUser] = useState(() => {
        return safeJsonParse(localStorage.getItem('nailedit_user'), null);
      });
      const [authMode, setAuthMode] = useState('login'); // 'login' | 'register'
      const [authName, setAuthName] = useState('');
      const [authEmail, setAuthEmail] = useState('');
      const [authPassword, setAuthPassword] = useState('');
      const [authLockUntil, setAuthLockUntil] = useState(0);
      const [failedLoginAttempts, setFailedLoginAttempts] = useState(0);
      const [editProfileName, setEditProfileName] = useState('');
      const [historyList, setHistoryList] = useState(() => {
        const parsed = safeJsonParse(localStorage.getItem('nailedit_history'), []);
        return Array.isArray(parsed) ? parsed.slice(0, 40) : [];
      });

      useEffect(() => {
        if (currentUser) setEditProfileName(currentUser.name || '');
      }, [currentUser]);

      useEffect(() => {
        try {
          localStorage.setItem('nailedit_history', JSON.stringify(historyList));
        } catch {}
      }, [historyList]);

      const triggerNailedItStamp = () => {
        setNailedItStamp(true);
        setTimeout(() => setNailedItStamp(false), 1600);
      };

      const startSessionWithQuestions = (qList, modeToUse = quizMode) => {
        if (!qList.length) return;
        setQuestions(qList);
        setCurrentIndex(0);
        setSelectedOption(null);
        setAnswersLog([]);
        setIsCardFlipped(false);
        setTimeLeft(45);
        setQuizMode(modeToUse);
        setSessionPhase('active');
        setActiveTab('quiz');
      };

      const handleStartNewSession = () => {
        if (selectedDocs.length === 0) {
          setIsFilePickerOpen(true);
          return;
        }
        const parsedCount = Math.min(30, Math.max(1, parseInt(questionCountInput, 10) || 5));
        setQuestionCountInput(String(parsedCount));
        const generated = buildQuestionsFromSelectedDocs(selectedDocs, parsedCount, lang);
        startSessionWithQuestions(generated, quizMode);
      };

      const handleAnswerSelect = (option) => {
        if (selectedOption !== null) return;
        const currentQ = questions[currentIndex];
        const isCorrect = option === currentQ.correctAnswer;
        setSelectedOption(option);
        setAnswersLog(prev => [...prev, { question: currentQ, chosen: option, isCorrect }]);
        if (isCorrect) {
          triggerNailedItStamp();
        }
      };

      const handleFlashcardResult = (knewIt) => {
        const currentQ = questions[currentIndex];
        setAnswersLog(prev => [...prev, { question: currentQ, chosen: knewIt ? currentQ.correctAnswer : '—', isCorrect: knewIt }]);
        if (knewIt) triggerNailedItStamp();
        advanceToNext(knewIt ? [...answersLog, { question: currentQ, isCorrect: true }] : [...answersLog, { question: currentQ, isCorrect: false }]);
      };

      const advanceToNext = (updatedLog = answersLog) => {
        if (currentIndex + 1 < questions.length) {
          setCurrentIndex(prev => prev + 1);
          setSelectedOption(null);
          setIsCardFlipped(false);
          setTimeLeft(45);
        } else {
          // Fine sessione e salvataggio in cronologia
          const correctCount = updatedLog.filter(a => a.isCorrect).length;
          const pct = Math.round((correctCount / questions.length) * 100);
          const entry = {
            id: `hist_${Date.now()}`,
            date: new Date().toLocaleString([], { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' }),
            mode: quizMode,
            score: correctCount,
            total: questions.length,
            pct,
            sources: Array.from(new Set(questions.map(q => q.docName))),
            mistakes: updatedLog.filter(a => !a.isCorrect).map(a => a.question)
          };
          setHistoryList(prev => [entry, ...prev].slice(0, 40));
          setSessionPhase('results');
        }
      };

      // Timer per la modalità Simulazione Esame
      useEffect(() => {
        if (sessionPhase !== 'active' || quizMode !== 'exam' || selectedOption !== null) return;
        const timer = setInterval(() => {
          setTimeLeft(prev => {
            if (prev <= 1) {
              clearInterval(timer);
              const currentQ = questions[currentIndex];
              if (currentQ) {
                const updated = [...answersLog, { question: currentQ, chosen: '⏱', isCorrect: false }];
                setAnswersLog(updated);
                advanceToNext(updated);
              }
              return 45;
            }
            return prev - 1;
          });
        }, 1000);
        return () => clearInterval(timer);
      }, [sessionPhase, quizMode, selectedOption, currentIndex, questions, answersLog]);

      // Autenticazione locale con rate-limiting anti brute-force e PBKDF2-SHA256
      const handleAuthSubmit = async (e) => {
        e.preventDefault();
        if (Date.now() < authLockUntil) {
          const secs = Math.ceil((authLockUntil - Date.now()) / 1000);
          showToast(`Troppi tentativi. Riprova tra ${secs}s.`);
          return;
        }
        const email = sanitizeText(authEmail, 80).toLowerCase();
        const emailValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
        if (!emailValid || authPassword.length < 4 || authPassword.length > 128) {
          showToast('Inserisci un’email valida e una password (min. 4 caratteri).');
          return;
        }
        const passHash = await hashPassword(authPassword, email);
        const storedUsers = safeJsonParse(localStorage.getItem('nailedit_users_db'), {});

        if (authMode === 'register') {
          const name = sanitizeText(authName, 40) || email.split('@')[0];
          const userObj = { name, email, passHash };
          storedUsers[email] = userObj;
          localStorage.setItem('nailedit_users_db', JSON.stringify(storedUsers));
          localStorage.setItem('nailedit_user', JSON.stringify({ name, email }));
          setCurrentUser({ name, email });
          setAuthPassword('');
          setFailedLoginAttempts(0);
        } else {
          const found = storedUsers[email];
          if (found && found.passHash === passHash) {
            localStorage.setItem('nailedit_user', JSON.stringify({ name: found.name, email: found.email }));
            setCurrentUser({ name: found.name, email: found.email });
            setAuthPassword('');
            setFailedLoginAttempts(0);
          } else if (!found) {
            // Se non registrato, crea profilo al volo per fluidità
            const name = email.split('@')[0];
            storedUsers[email] = { name, email, passHash };
            localStorage.setItem('nailedit_users_db', JSON.stringify(storedUsers));
            localStorage.setItem('nailedit_user', JSON.stringify({ name, email }));
            setCurrentUser({ name, email });
            setAuthPassword('');
            setFailedLoginAttempts(0);
          } else {
            const nextAttempts = failedLoginAttempts + 1;
            setFailedLoginAttempts(nextAttempts);
            if (nextAttempts >= 5) {
              setAuthLockUntil(Date.now() + 30000);
              setFailedLoginAttempts(0);
              showToast('Troppi tentativi falliti. Blocco temporaneo di 30 secondi.');
            } else {
              showToast('Password non corretta.');
            }
          }
        }
      };

      const handleUpdateUserName = (e) => {
        e.preventDefault();
        if (!currentUser) return;
        const clean = sanitizeText(editProfileName, 40);
        if (!clean) return;
        const updated = { ...currentUser, name: clean };
        setCurrentUser(updated);
        localStorage.setItem('nailedit_user', JSON.stringify(updated));
      };

      const handleLogout = () => {
        setCurrentUser(null);
        localStorage.removeItem('nailedit_user');
      };

      const currentQuestion = questions[currentIndex];
      const latestResult = historyList[0];

      const userStats = useMemo(() => {
        if (!historyList.length) return { total: 0, avg: 0 };
        const sum = historyList.reduce((acc, item) => acc + item.pct, 0);
        return { total: historyList.length, avg: Math.round(sum / historyList.length) };
      }, [historyList]);

      return (
        <div className="min-h-screen paper-grid flex flex-col">
          {/* Timbro animato "Nailed it!" quando indovini una risposta */}
          {nailedItStamp && (
            <div className="fixed top-20 right-6 z-50 pointer-events-none animate-stamp">
              <div className="px-4 py-2 rounded-lg bg-amber-400 text-stone-950 font-extrabold tracking-tight text-sm border-2 border-stone-950 shadow-lg flex items-center gap-2">
                <span>🎯</span>
                <span>Nailed it!</span>
              </div>
            </div>
          )}

          {/* Toast informativo */}
          {toastMsg && (
            <div className="fixed bottom-5 right-5 z-50 px-4 py-3 rounded-xl bg-stone-900 text-amber-50 dark:bg-stone-100 dark:text-stone-950 text-sm font-medium shadow-xl border border-stone-700">
              {toastMsg}
            </div>
          )}

          {/* Top Bar editoriale */}
          <header className="sticky top-0 z-30 bg-[#F7F5F0]/90 dark:bg-[#111110]/90 backdrop-blur-md border-b border-stone-300/80 dark:border-stone-800">
            <div className="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
              <button
                onClick={() => { setActiveTab('quiz'); setSessionPhase('setup'); }}
                className="flex items-center gap-3 text-left group"
              >
                <BrandLogo />
                <div>
                  <div className="flex items-center gap-2">
                    <span className="font-extrabold text-xl tracking-tight text-stone-900 dark:text-stone-100">
                      NailedIt
                    </span>
                  </div>
                  <p className="text-xs text-stone-600 dark:text-stone-400 font-medium">
                    {t.tagline}
                  </p>
                </div>
              </button>

              <div className="flex items-center gap-2 sm:gap-3">
                {/* Selettore 5 Lingue */}
                <div className="flex items-center bg-stone-200/80 dark:bg-stone-900 p-1 rounded-lg border border-stone-300/80 dark:border-stone-800">
                  {[
                    { code: 'it', label: 'IT' },
                    { code: 'en', label: 'EN' },
                    { code: 'es', label: 'ES' },
                    { code: 'de', label: 'DE' },
                    { code: 'fr', label: 'FR' }
                  ].map(item => (
                    <button
                      key={item.code}
                      onClick={() => setLang(item.code)}
                      className={`px-2 py-1 rounded-md text-xs font-bold transition ${
                        lang === item.code
                          ? 'bg-stone-900 text-amber-300 dark:bg-amber-400 dark:text-stone-950 shadow-xs'
                          : 'text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-200'
                      }`}
                    >
                      {item.label}
                    </button>
                  ))}
                </div>

                {/* Toggle Modalità Scura */}
                <button
                  onClick={() => setDarkMode(d => !d)}
                  aria-label="Toggle theme"
                  className="p-2.5 rounded-lg bg-white dark:bg-stone-900 border border-stone-300 dark:border-stone-800 text-stone-800 dark:text-stone-200 hover:border-stone-500 transition"
                >
                  <Icon name={darkMode ? 'sun' : 'moon'} className="w-4 h-4" />
                </button>
              </div>
            </div>
          </header>

          {/* Layout principale con barra laterale a sinistra */}
          <div className="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-6 sm:py-8 grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8">
            {/* Barra laterale sinistra */}
            <aside className="lg:col-span-3 flex flex-col justify-between gap-6">
              <nav className="bg-white dark:bg-stone-900/90 rounded-2xl p-2.5 border border-stone-300/90 dark:border-stone-800 tactile-card space-y-1">
                {[
                  { id: 'quiz', label: t.navQuiz, icon: 'quiz', badge: null },
                  { id: 'files', label: t.navFiles, icon: 'files', badge: docs.length > 0 ? `${docs.length}` : null },
                  { id: 'account', label: t.navAccount, icon: 'account', badge: null }
                ].map(item => {
                  const active = activeTab === item.id;
                  return (
                    <button
                      key={item.id}
                      onClick={() => setActiveTab(item.id)}
                      className={`w-full flex items-center justify-between px-3.5 py-3 rounded-xl text-sm font-bold transition ${
                        active
                          ? 'bg-stone-900 text-amber-300 dark:bg-amber-400 dark:text-stone-950'
                          : 'text-stone-700 dark:text-stone-300 hover:bg-stone-100 dark:hover:bg-stone-800/70'
                      }`}
                    >
                      <span className="flex items-center gap-3">
                        <Icon name={item.icon} className="w-4 h-4" />
                        <span>{item.label}</span>
                      </span>
                      {item.badge && (
                        <span className={`text-xs px-2 py-0.5 rounded-md font-mono ${
                          active
                            ? 'bg-amber-400/20 text-amber-200 dark:bg-stone-950/20 dark:text-stone-950'
                            : 'bg-stone-200 text-stone-700 dark:bg-stone-800 dark:text-stone-300'
                        }`}>
                          {item.badge}
                        </span>
                      )}
                    </button>
                  );
                })}
              </nav>

              {/* Riquadro pulito 100% gratuito */}
              <div className="bg-amber-100/75 dark:bg-stone-900 rounded-2xl p-4 border border-amber-300/80 dark:border-stone-800">
                <div className="flex items-center gap-2 text-stone-900 dark:text-amber-300 font-extrabold text-sm">
                  <span className="w-2 h-2 rounded-full bg-emerald-600" />
                  <span>{t.freeBadge}</span>
                </div>
              </div>
            </aside>

            {/* Area Centrale */}
            <main className="lg:col-span-9 space-y-6">
              {/* TAB 1: SEZIONE QUIZ */}
              {activeTab === 'quiz' && sessionPhase === 'setup' && (
                <div className="space-y-6">
                  {/* Intestazione editoriale "Cosa studiamo oggi?" */}
                  <div className="bg-stone-900 dark:bg-stone-900 text-[#F7F5F0] rounded-2xl p-6 sm:p-8 border border-stone-800 tactile-card relative overflow-hidden">
                    <div className="relative z-10 max-w-2xl space-y-2.5">
                      <h1 className="font-serif italic text-4xl sm:text-5xl tracking-tight text-amber-300">
                        {t.whatStudyToday}
                      </h1>
                      <p className="text-stone-300 text-sm sm:text-base leading-relaxed">
                        {t.heroSub}
                      </p>
                    </div>
                  </div>

                  {/* Pannello configurazione Quiz */}
                  <div className="bg-white dark:bg-stone-900 rounded-2xl p-6 sm:p-7 border border-stone-300/90 dark:border-stone-800 tactile-card space-y-6">
                    {/* Selezione fonti attive */}
                    <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-stone-200 dark:border-stone-800">
                      <div className="space-y-1">
                        <span className="text-xs font-bold uppercase tracking-wider text-stone-500 dark:text-stone-400">
                          {t.selectedSummary} ({selectedDocs.length}/{docs.length})
                        </span>
                        {selectedDocs.length > 0 ? (
                          <div className="flex flex-wrap gap-1.5 pt-1">
                            {selectedDocs.slice(0, 5).map(doc => (
                              <span
                                key={doc.id}
                                className="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-amber-100/90 dark:bg-amber-950/50 text-stone-900 dark:text-amber-200 border border-amber-300/80 dark:border-amber-800 text-xs font-semibold"
                              >
                                <span className="truncate max-w-[160px]">{doc.name}</span>
                              </span>
                            ))}
                            {selectedDocs.length > 5 && (
                              <span className="px-2.5 py-1 rounded-lg bg-stone-200 dark:bg-stone-800 text-xs font-bold">
                                +{selectedDocs.length - 5}
                              </span>
                            )}
                          </div>
                        ) : (
                          <p className="text-sm text-stone-600 dark:text-stone-400">{t.noFilesHint}</p>
                        )}
                      </div>

                      <button
                        onClick={() => setIsFilePickerOpen(true)}
                        className="shrink-0 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-stone-100 dark:bg-stone-800 hover:bg-amber-100 dark:hover:bg-stone-700 text-stone-900 dark:text-stone-100 border border-stone-300 dark:border-stone-700 text-sm font-bold transition"
                      >
                        <Icon name="files" className="w-4 h-4" />
                        <span>{t.chooseFilesBtn}</span>
                      </button>
                    </div>

                    {/* Scelta modalità */}
                    <div className="space-y-3">
                      <label className="block text-xs font-bold uppercase tracking-wider text-stone-500 dark:text-stone-400">
                        {t.modeLabel}
                      </label>
                      <div className="grid grid-cols-1 md:grid-cols-3 gap-3">
                        {[
                          { id: 'classic', title: t.modeClassic, desc: t.modeClassicDesc, icon: 'quiz' },
                          { id: 'exam', title: t.modeExam, desc: t.modeExamDesc, icon: 'clock' },
                          { id: 'flashcards', title: t.modeFlash, desc: t.modeFlashDesc, icon: 'cards' }
                        ].map(m => {
                          const active = quizMode === m.id;
                          return (
                            <button
                              key={m.id}
                              onClick={() => setQuizMode(m.id)}
                              className={`p-4 rounded-xl border text-left transition ${
                                active
                                  ? 'bg-amber-50/90 dark:bg-amber-950/30 border-stone-900 dark:border-amber-400 ring-1 ring-stone-900 dark:ring-amber-400'
                                  : 'bg-stone-50/70 dark:bg-stone-950/40 border-stone-200 dark:border-stone-800 hover:border-stone-400'
                              }`}
                            >
                              <div className="flex items-center justify-between mb-2">
                                <span className={`p-2 rounded-lg ${
                                  active
                                    ? 'bg-stone-900 text-amber-300 dark:bg-amber-400 dark:text-stone-950'
                                    : 'bg-stone-200/80 text-stone-700 dark:bg-stone-800 dark:text-stone-300'
                                }`}>
                                  <Icon name={m.icon} className="w-4 h-4" />
                                </span>
                                {active && <span className="w-2.5 h-2.5 rounded-full bg-amber-500" />}
                              </div>
                              <div className="font-bold text-sm text-stone-900 dark:text-stone-100">{m.title}</div>
                              <p className="text-xs text-stone-600 dark:text-stone-400 mt-1 leading-relaxed">{m.desc}</p>
                            </button>
                          );
