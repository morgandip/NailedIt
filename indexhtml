                      <div className="space-y-2">
                        <label className="block text-xs font-bold uppercase tracking-wider text-stone-500 dark:text-stone-400">
                          {t.qCountLabel}
                        </label>
                        <div className="flex items-center gap-2">
                          {[5, 10, 20].map(preset => (
                            <button
                              key={preset}
                              type="button"
                              onClick={() => setQuestionCountInput(String(preset))}
                              className={`px-3 py-2 rounded-lg text-xs font-mono font-bold border transition ${
                                Number(questionCountInput) === preset
                                  ? 'bg-stone-900 text-amber-300 border-stone-900 dark:bg-amber-400 dark:text-stone-950 dark:border-amber-400'
                                  : 'bg-stone-100 dark:bg-stone-800 text-stone-700 dark:text-stone-300 border-stone-300 dark:border-stone-700'
                              }`}
                            >
                              {preset}
                            </button>
                          ))}
                          <input
                            type="number"
                            min="1"
                            max="30"
                            value={questionCountInput}
                            onChange={(e) => setQuestionCountInput(e.target.value)}
                            className="w-20 px-3 py-2 rounded-lg bg-white dark:bg-stone-950 border border-stone-400 dark:border-stone-700 text-sm font-mono font-bold text-center focus:outline-none focus:border-stone-900 dark:focus:border-amber-400"
                          />
                        </div>
                      </div>

                      <button
                        onClick={handleStartNewSession}
                        className="inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-stone-950 font-extrabold text-sm border-2 border-stone-950 tactile-btn"
                      >
                        <span>{t.startSession}</span>
                        <Icon name="arrowRight" className="w-4 h-4" />
                      </button>
                    </div>
                  </div>
                </div>
              )}

              {/* SESSIONE ATTIVA: QUIZ / ESAME / FLASHCARD */}
              {activeTab === 'quiz' && sessionPhase === 'active' && currentQuestion && (
                <div className="bg-white dark:bg-stone-900 rounded-2xl p-6 sm:p-8 border border-stone-300/90 dark:border-stone-800 tactile-card space-y-6">
                  {/* Barra avanzamento */}
                  <div className="flex items-center justify-between gap-4">
                    <div className="flex items-center gap-3">
                      <button
                        onClick={() => setSessionPhase('setup')}
                        className="p-2 rounded-lg border border-stone-300 dark:border-stone-700 hover:bg-stone-100 dark:hover:bg-stone-800"
                      >
                        <Icon name="arrowLeft" className="w-4 h-4" />
                      </button>
                      <span className="font-mono text-sm font-bold">
                        {currentIndex + 1} / {questions.length}
                      </span>
                      <span className="text-xs px-2.5 py-1 rounded-md bg-stone-100 dark:bg-stone-800 text-stone-600 dark:text-stone-300 font-medium truncate max-w-[200px]">
                        {currentQuestion.docName}
                      </span>
                    </div>

                    {quizMode === 'exam' && (
                      <div className={`inline-flex items-center gap-1.5 px-3 py-1 rounded-lg font-mono text-xs font-bold border ${
                        timeLeft <= 10
                          ? 'bg-rose-100 text-rose-800 border-rose-300 dark:bg-rose-950/60 dark:text-rose-200 dark:border-rose-800'
                          : 'bg-stone-100 text-stone-800 border-stone-300 dark:bg-stone-800 dark:text-stone-200 dark:border-stone-700'
                      }`}>
                        <Icon name="clock" className="w-3.5 h-3.5" />
                        <span>{timeLeft}s</span>
                      </div>
                    )}
                  </div>

                  {/* Progress bar */}
                  <div className="w-full h-1.5 bg-stone-200 dark:bg-stone-800 rounded-full overflow-hidden">
                    <div
                      className="h-full bg-stone-900 dark:bg-amber-400 transition-all duration-300"
                      style={{ width: `${((currentIndex + 1) / questions.length) * 100}%` }}
                    />
                  </div>

                  {/* Modalità Flashcard */}
                  {quizMode === 'flashcards' ? (
                    <div className="space-y-5">
                      <div
                        onClick={() => setIsCardFlipped(f => !f)}
                        className="cursor-pointer min-h-[240px] p-6 sm:p-8 rounded-2xl bg-[#F7F5F0] dark:bg-stone-950 border-2 border-stone-300 dark:border-stone-800 hover:border-stone-900 dark:hover:border-amber-400 flex flex-col justify-between transition"
                      >
                        <div className="flex items-center justify-between text-xs font-mono text-stone-500">
                          <span>{currentQuestion.docName} • Pag. {currentQuestion.sourcePage}</span>
                          <span>{t.flipCard}</span>
                        </div>
                        <div className="my-6 space-y-3">
                          <div className="text-base sm:text-lg font-bold leading-relaxed text-stone-900 dark:text-stone-100">
                            {isCardFlipped ? currentQuestion.correctAnswer : currentQuestion.question}
                          </div>
                          {!isCardFlipped && currentQuestion.excerpt && (
                            <blockquote className="p-3.5 rounded-xl bg-white/80 dark:bg-stone-900 border-l-4 border-amber-500 text-sm font-medium text-stone-800 dark:text-stone-200 leading-relaxed">
                              {currentQuestion.excerpt}
                            </blockquote>
                          )}
                        </div>
                        {isCardFlipped && (
                          <p className="text-xs text-stone-600 dark:text-stone-400 italic border-t border-stone-300 dark:border-stone-800 pt-3">
                            «{currentQuestion.sourceQuote}»
                          </p>
                        )}
                      </div>

                      <div className="flex flex-wrap items-center justify-between gap-3">
                        <button
                          onClick={() => setPdfModal({
                            docId: currentQuestion.docId,
                            page: currentQuestion.sourcePage,
                            quote: currentQuestion.sourceQuote
                          })}
                          className="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-amber-100 dark:bg-amber-950/50 text-stone-900 dark:text-amber-200 border border-amber-400/80 text-xs font-bold"
                        >
                          <Icon name="page" className="w-4 h-4" />
                          <span>{t.openPdfPage} {currentQuestion.sourcePage} {t.ofPdf}</span>
                        </button>

                        <div className="flex items-center gap-2.5">
                          <button
                            onClick={() => handleFlashcardResult(false)}
                            className="px-4 py-2.5 rounded-xl bg-rose-100 text-rose-900 border border-rose-300 text-xs font-bold hover:bg-rose-200 transition"
                          >
                            {t.needReview}
                          </button>
                          <button
                            onClick={() => handleFlashcardResult(true)}
                            className="px-5 py-2.5 rounded-xl bg-emerald-600 text-white text-xs font-bold hover:bg-emerald-500 transition"
                          >
                            {t.gotIt}
                          </button>
                        </div>
                      </div>
                    </div>
                  ) : (
                    /* Modalità Quiz Classico ed Esame */
                    <div className="space-y-5">
                      <div className="space-y-3">
                        {currentQuestion.badge && (
                          <span className="inline-block px-2.5 py-0.5 rounded-md bg-amber-100 dark:bg-amber-950/60 text-amber-900 dark:text-amber-300 border border-amber-300/80 dark:border-amber-800 text-[11px] font-extrabold uppercase tracking-wider">
                            {currentQuestion.badge}
                          </span>
                        )}
                        <h2 className="text-base sm:text-lg font-bold leading-snug text-stone-900 dark:text-stone-100">
                          {currentQuestion.question}
                        </h2>
                        {currentQuestion.excerpt && (
                          <blockquote className="p-4 rounded-xl bg-[#F7F5F0] dark:bg-stone-950 border-l-4 border-stone-900 dark:border-amber-400 text-sm sm:text-base font-medium leading-relaxed text-stone-800 dark:text-stone-200">
                            {currentQuestion.excerpt}
                          </blockquote>
                        )}
                      </div>

                      <div className="space-y-2.5">
                        {currentQuestion.options.map((opt, idx) => {
                          const answered = selectedOption !== null;
                          const isCorrect = opt === currentQuestion.correctAnswer;
                          const isChosen = opt === selectedOption;

                          let styleClass = 'bg-stone-50 dark:bg-stone-950/60 border-stone-300 dark:border-stone-800 hover:border-stone-900 dark:hover:border-amber-400';
                          if (answered) {
                            if (isCorrect) {
                              styleClass = 'bg-emerald-50 dark:bg-emerald-950/50 border-emerald-600 text-emerald-950 dark:text-emerald-200';
                            } else if (isChosen) {
                              styleClass = 'bg-rose-50 dark:bg-rose-950/50 border-rose-600 text-rose-950 dark:text-rose-200';
                            } else {
                              styleClass = 'opacity-55 bg-stone-50 dark:bg-stone-950/40 border-stone-200 dark:border-stone-800';
                            }
                          }

                          return (
                            <button
                              key={idx}
                              disabled={answered}
                              onClick={() => handleAnswerSelect(opt)}
                              className={`w-full p-4 rounded-xl border text-left flex items-center justify-between gap-3 font-semibold text-sm transition ${styleClass}`}
                            >
                              <span className="flex items-center gap-3">
                                <span className="w-7 h-7 rounded-lg bg-stone-200/80 dark:bg-stone-800 flex items-center justify-center font-mono text-xs font-bold shrink-0">
                                  {String.fromCharCode(65 + idx)}
                                </span>
                                <span>{opt}</span>
                              </span>
                              {answered && isCorrect && (
                                <Icon name="check" className="w-4 h-4 text-emerald-600 shrink-0" />
                              )}
                              {answered && isChosen && !isCorrect && (
                                <Icon name="x" className="w-4 h-4 text-rose-600 shrink-0" />
                              )}
                            </button>
                          );
                        })}
                      </div>

                      {/* Azioni post-risposta: Estratto verificato + Apri Pagina PDF + Prossima */}
                      {selectedOption !== null && (
                        <div className="pt-4 border-t border-stone-200 dark:border-stone-800 space-y-3">
                          {currentQuestion.sourceQuote && (
                            <div className="p-3.5 rounded-xl bg-stone-100/90 dark:bg-stone-950 border border-stone-300 dark:border-stone-800 text-xs text-stone-700 dark:text-stone-300 leading-relaxed">
                              <span className="font-extrabold uppercase tracking-wider text-stone-900 dark:text-amber-300 block mb-1">
                                {t.sourceQuoteLabel} {currentQuestion.sourcePage}:
                              </span>
                              «{currentQuestion.sourceQuote}»
                            </div>
                          )}

                          <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                            <button
                              onClick={() => setPdfModal({
                                docId: currentQuestion.docId,
                                page: currentQuestion.sourcePage,
                                quote: currentQuestion.sourceQuote
                              })}
                              className="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-amber-100 hover:bg-amber-200 dark:bg-amber-950/60 dark:hover:bg-amber-900/60 text-stone-950 dark:text-amber-200 border border-amber-400 text-xs font-extrabold transition"
                            >
                              <Icon name="page" className="w-4 h-4" />
                              <span>{t.openPdfPage} {currentQuestion.sourcePage} {t.ofPdf}</span>
                            </button>

                            <button
                              onClick={() => advanceToNext()}
                              className="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-stone-900 dark:bg-amber-400 text-amber-300 dark:text-stone-950 text-xs font-extrabold"
                            >
                              <span>{currentIndex + 1 < questions.length ? t.nextQuestion : t.finishQuiz}</span>
                              <Icon name="arrowRight" className="w-4 h-4" />
                            </button>
                          </div>
                        </div>
                      )}
                    </div>
                  )}
                </div>
              )}

              {/* RISULTATI FINALI */}
              {activeTab === 'quiz' && sessionPhase === 'results' && latestResult && (
                <div className="bg-white dark:bg-stone-900 rounded-2xl p-6 sm:p-8 border border-stone-300/90 dark:border-stone-800 tactile-card space-y-6">
                  <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-stone-200 dark:border-stone-800">
                    <div>
                      <span className="text-xs font-bold uppercase tracking-wider text-stone-500">{t.sessionComplete}</span>
                      <h2 className="font-serif italic text-4xl text-stone-900 dark:text-amber-300 mt-1">
                        {latestResult.pct >= 70 ? 'Nailed it!' : t.scoreLabel}
                      </h2>
                    </div>
                    <div className="px-5 py-3 rounded-2xl bg-stone-900 dark:bg-amber-400 text-amber-300 dark:text-stone-950 font-mono text-2xl font-extrabold">
                      {latestResult.score}/{latestResult.total} ({latestResult.pct}%)
                    </div>
                  </div>

                  <div className="flex flex-wrap gap-3">
                    {latestResult.mistakes.length > 0 && (
                      <button
                        onClick={() => startSessionWithQuestions(latestResult.mistakes, 'classic')}
                        className="px-4 py-2.5 rounded-xl bg-amber-400 text-stone-950 border-2 border-stone-950 font-extrabold text-xs tactile-btn"
                      >
                        {t.reviewMistakes} ({latestResult.mistakes.length})
                      </button>
                    )}
                    <button
                      onClick={() => setSessionPhase('setup')}
                      className="px-4 py-2.5 rounded-xl bg-stone-100 dark:bg-stone-800 text-stone-900 dark:text-stone-100 border border-stone-300 dark:border-stone-700 font-bold text-xs"
                    >
                      {t.backToSetup}
                    </button>
                  </div>
                </div>
              )}

              {/* TAB 2: FILE CARICATI E CARTELLE (FINO A 130 PDF) */}
              {activeTab === 'files' && (
                <div className="space-y-6">
                  {/* Area Upload PDF */}
                  <div className="bg-white dark:bg-stone-900 rounded-2xl p-6 border border-stone-300/90 dark:border-stone-800 tactile-card space-y-4">
                    <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                      <div>
                        <h2 className="text-lg font-extrabold text-stone-900 dark:text-stone-100">{t.uploadTitle}</h2>
                        <p className="text-xs text-stone-600 dark:text-stone-400">{t.uploadSub}</p>
                      </div>
                      <span className="font-mono text-xs font-bold px-3 py-1 rounded-lg bg-stone-100 dark:bg-stone-800 border border-stone-300 dark:border-stone-700 self-start">
                        {docs.length} / {MAX_PDFS} PDF
                      </span>
                    </div>

                    {folders.length > 0 && (
                      <div className="flex flex-wrap items-center gap-2 text-xs">
                        <span className="font-bold text-stone-600 dark:text-stone-400">{t.targetFolder}</span>
                        <select
                          value={uploadTargetFolderId}
                          onChange={(e) => setUploadTargetFolderId(e.target.value)}
                          className="px-3 py-1.5 rounded-lg bg-stone-50 dark:bg-stone-950 border border-stone-300 dark:border-stone-700 font-semibold"
                        >
                          <option value="">{t.noFolder}</option>
                          {folders.map(f => (
                            <option key={f.id} value={f.id}>{f.name}</option>
                          ))}
                        </select>
                      </div>
                    )}

                    <label className="block border-2 border-dashed border-stone-400/80 dark:border-stone-700 hover:border-stone-900 dark:hover:border-amber-400 rounded-2xl p-8 text-center cursor-pointer bg-[#F7F5F0]/60 dark:bg-stone-950/40 transition">
                      <input
                        type="file"
                        accept="application/pdf"
                        multiple
                        className="hidden"
                        onChange={(e) => handleFilesUpload(e.target.files)}
                      />
                      <div className="w-11 h-11 rounded-xl bg-stone-900 dark:bg-amber-400 text-amber-300 dark:text-stone-950 mx-auto flex items-center justify-center mb-3">
                        <Icon name="upload" className="w-5 h-5" />
                      </div>
                      <p className="text-sm font-bold text-stone-900 dark:text-stone-100">
                        {isParsingPdf ? t.readingPdf : t.uploadSub}
                      </p>
                    </label>
                  </div>

                  {/* Gestione Cartelle */}
                  <div className="bg-white dark:bg-stone-900 rounded-2xl p-6 border border-stone-300/90 dark:border-stone-800 tactile-card space-y-4">
                    <h3 className="text-base font-extrabold text-stone-900 dark:text-stone-100">{t.foldersTitle}</h3>
                    <form onSubmit={handleCreateFolder} className="flex flex-wrap items-center gap-2.5">
                      <input
                        type="text"
                        value={newFolderName}
                        onChange={(e) => setNewFolderName(e.target.value)}
                        placeholder={t.folderPlaceholder}
                        className="flex-1 min-w-[200px] px-3.5 py-2 rounded-xl bg-stone-50 dark:bg-stone-950 border border-stone-300 dark:border-stone-700 text-sm"
                      />
                      <div className="flex items-center gap-1.5">
                        {FOLDER_ACCENTS.map(acc => (
                          <button
                            key={acc.id}
                            type="button"
                            onClick={() => setNewFolderColor(acc.id)}
                            className={`w-6 h-6 rounded-full ${acc.dot} ${newFolderColor === acc.id ? 'ring-2 ring-offset-2 ring-stone-900 dark:ring-amber-400' : 'opacity-65'}`}
                          />
                        ))}
                      </div>
                      <button
                        type="submit"
                        className="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-stone-900 dark:bg-amber-400 text-amber-300 dark:text-stone-950 text-xs font-extrabold"
                      >
                        <Icon name="plus" className="w-4 h-4" />
                        <span>{t.createFolder}</span>
                      </button>
                    </form>

                    {folders.length > 0 && (
                      <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
                        {folders.map(folder => {
                          const folderDocs = docs.filter(d => (d.folderIds || []).includes(folder.id));
                          const allSelected = folderDocs.length > 0 && folderDocs.every(d => selectedSet.has(d.id));
                          const accent = FOLDER_ACCENTS.find(a => a.id === folder.color) || FOLDER_ACCENTS[0];
                          return (
                            <div
                              key={folder.id}
                              className="p-4 rounded-xl bg-stone-50 dark:bg-stone-950/60 border border-stone-300 dark:border-stone-800 flex items-center justify-between gap-3"
                            >
                              <div className="min-w-0">
                                <div className="flex items-center gap-2">
                                  <span className={`w-2.5 h-2.5 rounded-full ${accent.dot}`} />
                                  <span className="font-bold text-sm truncate">{folder.name}</span>
                                </div>
                                <span className="text-xs text-stone-500 font-mono">{folderDocs.length} PDF</span>
                              </div>
                              <div className="flex items-center gap-1.5 shrink-0">
                                <button
                                  onClick={() => toggleFolderGroupSelection(folder.id)}
                                  className={`px-2.5 py-1.5 rounded-lg text-xs font-bold border transition ${
                                    allSelected
                                      ? 'bg-stone-900 text-amber-300 border-stone-900 dark:bg-amber-400 dark:text-stone-950'
                                      : 'bg-white dark:bg-stone-900 border-stone-300 dark:border-stone-700'
                                  }`}
                                >
                                  {allSelected ? t.selectedGroup : t.selectGroup}
                                </button>
                                <button
                                  onClick={() => handleDeleteFolder(folder.id)}
                                  className="p-1.5 rounded-lg text-stone-500 hover:text-rose-600"
                                >
                                  <Icon name="trash" className="w-4 h-4" />
                                </button>
                              </div>
                            </div>
                          );
                        })}
                      </div>
                    )}
                  </div>

                  {/* Lista documenti caricati */}
                  {docs.length > 0 && (
                    <div className="bg-white dark:bg-stone-900 rounded-2xl p-6 border border-stone-300/90 dark:border-stone-800 tactile-card space-y-3">
                      <h3 className="text-base font-extrabold">{t.allDocsTitle} ({docs.length})</h3>
                      <div className="divide-y divide-stone-200 dark:divide-stone-800">
                        {docs.map(doc => {
                          const isSelected = selectedSet.has(doc.id);
                          return (
                            <div key={doc.id} className="py-3 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                              <div className="flex items-center gap-3 min-w-0">
                                <input
                                  type="checkbox"
                                  checked={isSelected}
                                  onChange={() => toggleDocSelection(doc.id)}
                                  className="w-4 h-4 accent-stone-900 rounded"
                                />
                                <div className="min-w-0">
                                  <p className="text-sm font-bold truncate">{doc.name}</p>
                                  <p className="text-xs text-stone-500 font-mono">{doc.numPages} {t.pages}</p>
                                </div>
                              </div>

                              <div className="flex flex-wrap items-center gap-1.5">
                                {folders.map(f => {
                                  const inFolder = (doc.folderIds || []).includes(f.id);
                                  return (
                                    <button
                                      key={f.id}
                                      onClick={() => toggleDocInFolder(doc.id, f.id)}
                                      className={`px-2 py-0.5 rounded-md text-[11px] font-bold border transition ${
                                        inFolder
                                          ? 'bg-amber-200/90 text-stone-950 border-amber-400 dark:bg-amber-900/60 dark:text-amber-200'
                                          : 'bg-stone-100 dark:bg-stone-800 text-stone-500 border-transparent'
                                      }`}
                                    >
                                      {inFolder ? '✓ ' : '+ '}{f.name}
                                    </button>
                                  );
                                })}
                                <button
                                  onClick={() => setPdfModal({ docId: doc.id, page: 1, quote: doc.pages[0]?.text?.slice(0, 220) || '' })}
                                  className="p-1.5 rounded-lg text-stone-600 dark:text-stone-300 hover:bg-stone-100 dark:hover:bg-stone-800"
                                  title={t.openPdfPage}
                                >
                                  <Icon name="page" className="w-4 h-4" />
                                </button>
                                <button
                                  onClick={() => handleDeleteDoc(doc.id)}
                                  className="p-1.5 rounded-lg text-stone-500 hover:text-rose-600"
                                >
                                  <Icon name="trash" className="w-4 h-4" />
                                </button>
                              </div>
                            </div>
                          );
                        })}
                      </div>
                    </div>
                  )}
                </div>
              )}

              {/* TAB 3: ACCOUNT & CRONOLOGIA */}
              {activeTab === 'account' && (
                <div className="space-y-6">
                  <div className="bg-white dark:bg-stone-900 rounded-2xl p-6 sm:p-7 border border-stone-300/90 dark:border-stone-800 tactile-card">
                    {!currentUser ? (
                      <div className="max-w-md space-y-5">
                        <div>
                          <h2 className="text-xl font-extrabold">{t.accountTitle}</h2>
                          <p className="text-xs text-stone-600 dark:text-stone-400 mt-1 leading-relaxed">{t.accountDesc}</p>
                        </div>

                        <div className="inline-flex p-1 rounded-xl bg-stone-100 dark:bg-stone-800">
                          <button
                            onClick={() => setAuthMode('login')}
                            className={`px-3.5 py-1.5 rounded-lg text-xs font-bold ${authMode === 'login' ? 'bg-white dark:bg-stone-900 shadow-xs' : 'text-stone-500'}`}
                          >
                            {t.loginTab}
                          </button>
                          <button
                            onClick={() => setAuthMode('register')}
                            className={`px-3.5 py-1.5 rounded-lg text-xs font-bold ${authMode === 'register' ? 'bg-white dark:bg-stone-900 shadow-xs' : 'text-stone-500'}`}
                          >
                            {t.registerTab}
                          </button>
                        </div>

                        <form onSubmit={handleAuthSubmit} className="space-y-3">
                          {authMode === 'register' && (
                            <div>
                              <label className="block text-xs font-bold mb-1">{t.nameLabel}</label>
                              <input
                                type="text"
                                value={authName}
                                onChange={(e) => setAuthName(e.target.value)}
                                className="w-full px-3.5 py-2 rounded-xl bg-stone-50 dark:bg-stone-950 border border-stone-300 dark:border-stone-700 text-sm"
                                required
                              />
                            </div>
                          )}
                          <div>
                            <label className="block text-xs font-bold mb-1">{t.emailLabel}</label>
                            <input
                              type="email"
                              value={authEmail}
                              onChange={(e) => setAuthEmail(e.target.value)}
                              className="w-full px-3.5 py-2 rounded-xl bg-stone-50 dark:bg-stone-950 border border-stone-300 dark:border-stone-700 text-sm"
                              required
                            />
                          </div>
                          <div>
                            <label className="block text-xs font-bold mb-1">{t.passwordLabel}</label>
                            <input
                              type="password"
                              value={authPassword}
                              onChange={(e) => setAuthPassword(e.target.value)}
                              className="w-full px-3.5 py-2 rounded-xl bg-stone-50 dark:bg-stone-950 border border-stone-300 dark:border-stone-700 text-sm"
                              required
                            />
                          </div>
                          <button
                            type="submit"
                            className="px-5 py-2.5 rounded-xl bg-stone-900 dark:bg-amber-400 text-amber-300 dark:text-stone-950 text-xs font-extrabold"
                          >
                            {authMode === 'login' ? t.submitLogin : t.submitRegister}
                          </button>
                        </form>
                      </div>
                    ) : (
                      <div className="space-y-5">
                        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                          <div className="flex items-center gap-3.5">
                            <div className="w-12 h-12 rounded-xl bg-stone-900 dark:bg-amber-400 text-amber-300 dark:text-stone-950 flex items-center justify-center font-extrabold text-lg">
                              {currentUser.name.slice(0, 2).toUpperCase()}
                            </div>
                            <div>
                              <h2 className="text-lg font-extrabold">{currentUser.name}</h2>
                              <p className="text-xs text-stone-500">{currentUser.email}</p>
                            </div>
                          </div>
                          <button
                            onClick={handleLogout}
                            className="px-3.5 py-2 rounded-xl border border-stone-300 dark:border-stone-700 text-xs font-bold hover:bg-stone-100 dark:hover:bg-stone-800 self-start"
                          >
                            {t.logoutBtn}
                          </button>
                        </div>

                        <form onSubmit={handleUpdateUserName} className="flex items-center gap-2 max-w-sm">
                          <input
                            type="text"
                            value={editProfileName}
                            onChange={(e) => setEditProfileName(e.target.value)}
                            className="flex-1 px-3 py-1.5 rounded-lg bg-stone-50 dark:bg-stone-950 border border-stone-300 dark:border-stone-700 text-xs font-semibold"
                          />
                          <button
                            type="submit"
                            className="px-3 py-1.5 rounded-lg bg-stone-900 dark:bg-amber-400 text-amber-300 dark:text-stone-950 text-xs font-bold"
                          >
                            {t.updateNameBtn}
                          </button>
                        </form>
                      </div>
                    )}
                  </div>

                  {/* Riepilogo e Cronologia */}
                  <div className="grid grid-cols-3 gap-3">
                    <div className="bg-white dark:bg-stone-900 p-4 rounded-2xl border border-stone-300/90 dark:border-stone-800">
                      <span className="text-xs text-stone-500 block">{t.statsSessions}</span>
                      <span className="font-mono text-2xl font-extrabold">{userStats.total}</span>
                    </div>
                    <div className="bg-white dark:bg-stone-900 p-4 rounded-2xl border border-stone-300/90 dark:border-stone-800">
                      <span className="text-xs text-stone-500 block">{t.statsAvg}</span>
                      <span className="font-mono text-2xl font-extrabold">{userStats.avg}%</span>
                    </div>
                    <div className="bg-white dark:bg-stone-900 p-4 rounded-2xl border border-stone-300/90 dark:border-stone-800">
                      <span className="text-xs text-stone-500 block">{t.statsDocs}</span>
                      <span className="font-mono text-2xl font-extrabold">{docs.length}</span>
                    </div>
                  </div>

                  <div className="bg-white dark:bg-stone-900 rounded-2xl p-6 border border-stone-300/90 dark:border-stone-800 tactile-card space-y-3">
                    <h3 className="text-base font-extrabold">{t.historyTitle}</h3>
                    {historyList.length === 0 ? (
                      <p className="text-xs text-stone-500">{t.noHistory}</p>
                    ) : (
                      <div className="divide-y divide-stone-200 dark:divide-stone-800">
                        {historyList.map(item => (
                          <div key={item.id} className="py-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                            <div>
                              <div className="flex items-center gap-2">
                                <span className="font-mono text-xs font-bold px-2 py-0.5 rounded bg-stone-100 dark:bg-stone-800">
                                  {item.score}/{item.total} ({item.pct}%)
                                </span>
                                <span className="text-xs text-stone-500">{item.date}</span>
                              </div>
                              <p className="text-xs text-stone-600 dark:text-stone-400 mt-1 truncate max-w-md">
                                {item.sources.join(', ')}
                              </p>
                            </div>
                            {item.mistakes?.length > 0 && (
                              <button
                                onClick={() => startSessionWithQuestions(item.mistakes, 'classic')}
                                className="px-3 py-1.5 rounded-lg bg-amber-100 dark:bg-amber-950/50 text-stone-900 dark:text-amber-200 border border-amber-300 text-xs font-bold self-start"
                              >
                                {t.reviewMistakes} ({item.mistakes.length})
                              </button>
                            )}
                          </div>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              )}
            </main>
          </div>

          {/* MODALE SELETTORE FILE & CARTELLE */}
          {isFilePickerOpen && (
            <div className="fixed inset-0 z-50 bg-stone-950/60 backdrop-blur-xs flex items-center justify-center p-4">
              <div className="bg-white dark:bg-stone-900 rounded-2xl max-w-xl w-full max-h-[85vh] flex flex-col border border-stone-300 dark:border-stone-700 shadow-2xl overflow-hidden">
                <div className="px-6 py-4 border-b border-stone-200 dark:border-stone-800 flex items-center justify-between">
                  <h3 className="font-extrabold text-base">{t.modalSelectTitle}</h3>
                  <button onClick={() => setIsFilePickerOpen(false)} className="p-1.5 rounded-lg hover:bg-stone-100 dark:hover:bg-stone-800">
                    <Icon name="x" className="w-4 h-4" />
                  </button>
                </div>

                <div className="p-6 overflow-y-auto space-y-5">
                  {docs.length === 0 ? (
                    <div className="text-center py-6 space-y-3">
                      <p className="text-sm text-stone-600 dark:text-stone-400">{t.noFilesHint}</p>
                      <button
                        onClick={() => { setIsFilePickerOpen(false); setActiveTab('files'); }}
                        className="px-4 py-2 rounded-xl bg-stone-900 dark:bg-amber-400 text-amber-300 dark:text-stone-950 text-xs font-extrabold"
                      >
                        {t.uploadTitle}
                      </button>
                    </div>
                  ) : (
                    <>
                      {folders.length > 0 && (
                        <div className="space-y-2">
                          <span className="text-xs font-bold uppercase tracking-wider text-stone-500">{t.foldersTitle}</span>
                          <div className="flex flex-wrap gap-2">
                            {folders.map(f => {
                              const folderDocs = docs.filter(d => (d.folderIds || []).includes(f.id));
                              const allSel = folderDocs.length > 0 && folderDocs.every(d => selectedSet.has(d.id));
                              return (
                                <button
                                  key={f.id}
                                  onClick={() => toggleFolderGroupSelection(f.id)}
                                  className={`px-3 py-1.5 rounded-xl text-xs font-bold border transition ${
                                    allSel
                                      ? 'bg-stone-900 text-amber-300 border-stone-900 dark:bg-amber-400 dark:text-stone-950'
                                      : 'bg-stone-100 dark:bg-stone-800 border-stone-300 dark:border-stone-700'
                                  }`}
                                >
                                  {f.name} ({folderDocs.length})
                                </button>
                              );
                            })}
                          </div>
                        </div>
                      )}

                      <div className="space-y-2">
                        <span className="text-xs font-bold uppercase tracking-wider text-stone-500">{t.allDocsTitle}</span>
                        <div className="space-y-1.5">
                          {docs.map(doc => (
                            <label
                              key={doc.id}
                              className="flex items-center justify-between p-3 rounded-xl border border-stone-200 dark:border-stone-800 hover:bg-stone-50 dark:hover:bg-stone-800/50 cursor-pointer"
                            >
                              <span className="flex items-center gap-3 min-w-0">
                                <input
                                  type="checkbox"
                                  checked={selectedSet.has(doc.id)}
                                  onChange={() => toggleDocSelection(doc.id)}
                                  className="w-4 h-4 accent-stone-900"
                                />
                                <span className="text-sm font-semibold truncate">{doc.name}</span>
                              </span>
                              <span className="text-xs font-mono text-stone-500 shrink-0">{doc.numPages} {t.pages}</span>
                            </label>
                          ))}
                        </div>
                      </div>
                    </>
                  )}
                </div>

                <div className="px-6 py-4 border-t border-stone-200 dark:border-stone-800 flex items-center justify-between">
                  <button
                    onClick={() => { setIsFilePickerOpen(false); setActiveTab('files'); }}
                    className="text-xs font-bold underline text-stone-600 dark:text-stone-400"
                  >
                    + {t.uploadTitle}
                  </button>
                  <button
                    onClick={() => setIsFilePickerOpen(false)}
                    className="px-4 py-2 rounded-xl bg-stone-900 dark:bg-amber-400 text-amber-300 dark:text-stone-950 text-xs font-extrabold"
                  >
                    {t.confirmSelection} ({selectedDocs.length})
                  </button>
                </div>
              </div>
            </div>
          )}

          {/* MODALE RISCONTRO PAGINA ORIGINALE DEL PDF */}
          {pdfModal && (() => {
            const doc = docMap.get(pdfModal.docId);
            if (!doc) return null;
            const safePage = Math.min(Math.max(1, pdfModal.page), doc.numPages);
            const pageData = doc.pages.find(p => p.page === safePage) || doc.pages[0];

            return (
              <div className="fixed inset-0 z-50 bg-stone-950/65 backdrop-blur-xs flex items-center justify-center p-4">
                <div className="bg-white dark:bg-stone-900 rounded-2xl max-w-2xl w-full max-h-[88vh] flex flex-col border border-stone-300 dark:border-stone-700 shadow-2xl overflow-hidden">
                  <div className="px-6 py-4 bg-stone-900 text-amber-300 flex items-center justify-between gap-3">
                    <div className="flex items-center gap-2 min-w-0">
                      <Icon name="page" className="w-4 h-4 shrink-0" />
                      <span className="font-bold text-sm truncate">
                        {doc.name} — Pagina {safePage} / {doc.numPages}
                      </span>
                    </div>
                    <button onClick={() => setPdfModal(null)} className="p-1.5 rounded-lg hover:bg-white/10">
                      <Icon name="x" className="w-4 h-4" />
                    </button>
                  </div>

                  {pdfModal.quote && (
                    <div className="px-6 py-3.5 bg-amber-100/90 dark:bg-amber-950/50 border-b border-amber-300 dark:border-amber-800 text-xs">
                      <span className="font-extrabold uppercase tracking-wider text-stone-700 dark:text-amber-300 block mb-1">
                        {t.sourceQuoteLabel}:
                      </span>
                      <p className="text-stone-900 dark:text-stone-100 font-medium leading-relaxed">
                        «{pdfModal.quote}»
                      </p>
                    </div>
                  )}

                  <div className="p-6 overflow-y-auto bg-[#F7F5F0] dark:bg-stone-950 text-sm leading-relaxed text-stone-800 dark:text-stone-200 whitespace-pre-line font-sans">
                    {pageData?.text}
                  </div>

                  <div className="px-6 py-3.5 border-t border-stone-200 dark:border-stone-800 flex items-center justify-between">
                    <div className="flex items-center gap-2">
                      <button
                        disabled={safePage <= 1}
                        onClick={() => setPdfModal(m => ({ ...m, page: safePage - 1, quote: '' }))}
                        className="px-3 py-1.5 rounded-lg border border-stone-300 dark:border-stone-700 text-xs font-bold disabled:opacity-40"
                      >
                        {t.prevPage}
                      </button>
                      <button
                        disabled={safePage >= doc.numPages}
                        onClick={() => setPdfModal(m => ({ ...m, page: safePage + 1, quote: '' }))}
                        className="px-3 py-1.5 rounded-lg border border-stone-300 dark:border-stone-700 text-xs font-bold disabled:opacity-40"
                      >
                        {t.nextPage}
                      </button>
                    </div>

                    <button
                      onClick={() => setPdfModal(null)}
                      className="px-4 py-1.5 rounded-lg bg-stone-900 dark:bg-amber-400 text-amber-300 dark:text-stone-950 text-xs font-extrabold"
                    >
                      {t.close}
                    </button>
                  </div>
                </div>
              </div>
            );
          })()}
        </div>
      );
    }

    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(<App />);
  </script>
</body>
</html>
